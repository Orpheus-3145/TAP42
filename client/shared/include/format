// Compatibility shim for <format>.
// Toolchains with a real <format> (GCC >= 13, ...) use it untouched; older ones
// (e.g. GCC 10-12 on Ubuntu 22.04) get a minimal std::format that supports
// "{}" placeholders, "{{"/"}}" escapes and "{:<strftime spec>}" for
// std::chrono::system_clock time points -- the only forms this project uses.
#pragma once

#if __has_include_next(<format>)
#  include_next <format>
#else

#include <chrono>
#include <ctime>
#include <sstream>
#include <string>
#include <string_view>

namespace std
{
namespace compat_format
{
template <class T>
inline std::string render(const T &value, std::string_view)
{
	std::ostringstream oss;
	oss << value;
	return oss.str();
}

template <class Clock, class Dur>
inline std::string render(const std::chrono::time_point<Clock, Dur> &tp, std::string_view spec)
{
	std::time_t t = Clock::to_time_t(std::chrono::time_point_cast<typename Clock::duration>(tp));
	std::tm tmv{};
	gmtime_r(&t, &tmv);
	std::string pattern(spec.empty() ? "%F %T" : spec);
	char buf[128];
	std::size_t n = std::strftime(buf, sizeof(buf), pattern.c_str(), &tmv);
	return std::string(buf, n);
}
} // namespace compat_format

template <class... Args>
inline std::string format(std::string_view fmt, const Args &...args)
{
	using Renderer = std::string (*)(const void *, std::string_view);
	const void *ptrs[sizeof...(Args) + 1] = {static_cast<const void *>(&args)...};
	Renderer rends[sizeof...(Args) + 1] = {
		[](const void *p, std::string_view s) { return compat_format::render(*static_cast<const Args *>(p), s); }...};

	std::string out;
	std::size_t next = 0;
	for (std::size_t i = 0; i < fmt.size(); ++i)
	{
		char c = fmt[i];
		if (c == '{' && i + 1 < fmt.size() && fmt[i + 1] == '{')
			out += '{', ++i;
		else if (c == '}' && i + 1 < fmt.size() && fmt[i + 1] == '}')
			out += '}', ++i;
		else if (c == '{')
		{
			std::size_t close = fmt.find('}', i);
			if (close == std::string_view::npos)
				break;
			std::string_view spec;
			if (close > i + 1 && fmt[i + 1] == ':')
				spec = fmt.substr(i + 2, close - i - 2);
			if (next + 1 <= sizeof...(Args))
			{
				out += rends[next](ptrs[next], spec);
				++next;
			}
			i = close;
		}
		else
			out += c;
	}
	return out;
}
} // namespace std

#endif
